# ============================================================
# متغيرات البيئة المطلوبة للتشغيل — انسخها لـ .env محليًا
# وعلى الاستضافة (Vercel / Cloudflare / Netlify) ضيفها من لوحة
# Project Settings -> Environment Variables.
#
# ملاحظة: ملف .env نفسه مش بيرفع على git (موجود في .gitignore)
# ============================================================

# --- Supabase ---
SUPABASE_PROJECT_ID=byyyqisqdocxqtytkgdm
SUPABASE_URL=https://byyyqisqdocxqtytkgdm.supabase.co
# publishable key = آمنة في المتصفح (مصممة تكون عامة ويحميها RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# service_role = سرية بالكامل، بتُستخدم من السيرفر فقط (الداشبورد + التتبّع + إرسال البطاقة)
# ضيفها من: Supabase -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# --- نفس القيم لحزمة Vite (تُضمَّن في كود المتصفح: publishable فقط) ---
VITE_SUPABASE_PROJECT_ID=byyyqisqdocxqtytkgdm
VITE_SUPABASE_URL=https://byyyqisqdocxqtytkgdm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
